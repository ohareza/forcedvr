{
  "manifest_version": 3,
  "name": "Force enable YouTube DVR",
  "version": "1.1.0",
  "description": "Enable rewind on YouTube live streams when past segments are available.",
  "minimum_chrome_version": "102",
  "icons": {
    "48": "enabled.png",
    "128": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://www.youtube-nocookie.com/*"
  ],
  "action": {
    "default_title": "Force DVR (click to toggle)",
    "default_icon": {
      "48": "enabled.png"
    }
  }
}
